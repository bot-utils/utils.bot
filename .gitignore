# Public source allowlist. Operator files stay local.
*
!*/
# Application, native and test source.
!*.c
!*.cc
!*.css
!*.gclient
!*.gn
!*.go
!*.h
!*.html
!*.inc
!*.js
!*.mts
!*.patch
!*.py
!*.sh
!*.sources
!*.svg
# Required build inputs, public service assets and legal notices.
!/.dockerignore
!/.gitignore
!/COPYRIGHT
!/DEPENDENCIES.md
!/Dockerfile
!/Dockerfile.browser
!/Dockerfile.browser.dockerignore
!/README.md
!/SOURCE.md
!/THIRD_PARTY.md
