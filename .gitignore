!/internal/docs/openapi.json
!/internal/docs/swagger-assets.json
!/internal/serviceinfo/readme.md
!/licenses/html/HAGEZI-GPL-3.0.txt
!/licenses/html/X-NET-LICENSE.txt
!/licenses/pdfium/CHROMIUM-BUILD-LICENSE
!/licenses/pdfium/CHROMIUM-BUILD-NOTICE.txt
!/licenses/pdfium/CPDF-DIB-NOTICE.txt
!/licenses/pdfium/LICENSE
!/licenses/pdfium/PROVENANCE.md
!/licenses/poppler/COPYING
!/licenses/poppler/COPYING3
!/licenses/poppler/STREAM-CC-NOTICE.txt
!/native/browser-libraries.json
!/native/licenses/MPL-2.0.txt
!/native/licenses/PROVENANCE.json
!/native/licenses/compiler-rt-LICENSE.TXT
!/native/licenses/dejavu-LICENSE
!/native/licenses/fontconfig-COPYING
!/native/licenses/libcxx-LICENSE.TXT
!/native/licenses/libcxxabi-LICENSE.TXT
!/native/licenses/libunwind-LICENSE.TXT
!/native/licenses/musl-COPYRIGHT
!/prototypes/csv/.gitignore
!/prototypes/csv/Dockerfile
!/prototypes/csv/go.mod
!/prototypes/csv/go.sum
!/testdata/bad.pdf
!/testdata/different.pdf
!/testdata/hello.pdf
# Private tooling and generated data remain excluded even when code.
/infra/
/prototypes/csv/benchmarks/
/cmd/browser-bench/
/cmd/browser-probe/
/cmd/microvm-probe/
/cmd/private-edge-check/
/build/
/reports/
/publication/
**/__pycache__/
**/*.pyc
**/.env*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.aws/
**/.ssh/
**/.codex/
