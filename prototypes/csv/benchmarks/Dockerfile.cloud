FROM python:3.9-slim-bookworm@sha256:a02e9c5406c416c504d6c9a1a306ff4080c3173f1008d192f953bd20382a2d5c
COPY --chmod=0444 worker.py fixtures.py cloud_smoke.py /app/
RUN mkdir -m 0700 /work && chown 10001:10001 /work && chmod 0555 /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
VOLUME ["/work"]
ENTRYPOINT ["python", "/app/cloud_smoke.py"]
